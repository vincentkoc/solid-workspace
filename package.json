{
  "name": "@vincentkoc/solid-workspace",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css",
    "./model": {
      "types": "./dist/model.d.ts",
      "import": "./dist/model.js"
    }
  },
  "scripts": {
    "build": "vite build && tsc --emitDeclarationOnly && cp src/style.css dist/style.css",
    "check": "tsc --noEmit",
    "test": "tsx --test test/model.test.ts",
    "dev": "vite --host 127.0.0.1"
  },
  "peerDependencies": {
    "solid-js": "2.0.0-rc.18",
    "@solidjs/web": "2.0.0-rc.18"
  },
  "devDependencies": {
    "solid-js": "2.0.0-rc.18",
    "@solidjs/web": "2.0.0-rc.18",
    "@solidjs/vite-plugin": "3.0.0-next.51",
    "typescript": "^5.9.3",
    "tsx": "^4.20.6",
    "vite": "8.3.5",
    "@types/node": "^22.18.0",
    "playwright": "^1.56.1"
  },
  "overrides": {
    "@solidjs/compiler": "2.0.0-rc.18",
    "@solidjs/babel-plugin": "2.0.0-rc.18",
    "@solidjs/signals": "2.0.0-rc.18"
  }
}
